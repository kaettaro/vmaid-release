{
  "name": "vmaid",
  "version": "0.1.0",
  "description": "VRMモデル・VRMAモーション・ローカルLLMを換装できる、常駐3Dバーチャルコンパニオン(仮称)",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "postinstall": "install-electron",
    "licenses": "node scripts/gen-licenses.mjs",
    "build:dir": "npm run build && npm run licenses && electron-builder --dir",
    "build:mac": "npm run build && npm run licenses && electron-builder --mac",
    "build:win": "npm run build && npm run licenses && electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "dependencies": {
    "@moeru/three-mmd": "^0.2.0-beta.2",
    "@moeru/three-mmd-physics-ammo": "^0.2.0-beta.2",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "fflate": "0.8.3",
    "node-llama-cpp": "^3.22.1",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "simple-git": "^4.0.2"
  },
  "author": "tamo"
}
